# Public browser configuration. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public base URL only. Authentication and tenant membership are checked again by Dishbee One.
VITE_DISHBEE_ONE_URL=https://your-dishbee-one-staging.example

# Server-only Edge Function secrets. Set these in Supabase, never in a VITE_ variable.
# DISHBEE_ONE_HANDOFF_URL=https://your-dishbee-one-staging.example/api/dishbee-plus/orders
# DISHBEE_ONE_CONNECTOR_TOKEN=replace-with-a-separate-bearer-token
# DISHBEE_ONE_HANDOFF_SECRET=replace-with-at-least-32-random-bytes
# CRON_SECRET=replace-with-a-separate-random-cron-secret
